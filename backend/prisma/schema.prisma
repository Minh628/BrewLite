generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          Int              @id @default(autoincrement())
  categoryId  Int
  name        String           @unique
  description String?
  price       Int
  imageUrl    String?
  stock       Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id])
  sizes       ProductSize[]
  toppings    ProductTopping[]
  orderItems  OrderItem[]

  @@index([categoryId, isActive])
}

model ProductSize {
  productId  Int
  size       String
  extraPrice Int     @default(0)
  product    Product @relation(fields: [productId], references: [id])

  @@id([productId, size])
}

model Topping {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  price             Int
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  products          ProductTopping[]
  orderItemToppings OrderItemTopping[]
}

model ProductTopping {
  productId Int
  toppingId Int
  product   Product @relation(fields: [productId], references: [id])
  topping   Topping @relation(fields: [toppingId], references: [id])

  @@id([productId, toppingId])
  @@index([toppingId])
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  loyaltyPoints Int      @default(0)
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  orders        Order[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Int // Đơn vị VND, do server tính toán
  createdAt DateTime    @default(now())
  items     OrderItem[]
  payments  Payment[]

  @@index([userId, createdAt])
}

model OrderItem {
  id        Int                @id @default(autoincrement())
  orderId   Int
  order     Order              @relation(fields: [orderId], references: [id])
  productId Int
  product   Product            @relation(fields: [productId], references: [id])
  size      Size
  qty       Int
  unitPrice Int
  lineTotal Int
  toppings  OrderItemTopping[]
}

model OrderItemTopping {
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingId   Int
  topping     Topping   @relation(fields: [toppingId], references: [id])
  price       Int // Giá topping tại thời điểm tạo đơn

  @@id([orderItemId, toppingId])
}

model Payment {
  idempotencyKey String        @id
  orderId        Int
  amount         Int
  method         PaymentMethod
  status         String
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id])
}
