    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.0",
        "eslint": "^9.0.0",
        "prisma": "^6.14.0",
        "tsx": "^4.19.0",
