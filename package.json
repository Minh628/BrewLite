{
  "name": "brewlite",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @brewlite/backend\" \"npm run dev --workspace @brewlite/frontend\"",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d postgres",
    "dev:barista": "npm run dev:barista --workspace @brewlite/frontend",
    "build": "npm run build --workspace @brewlite/backend && npm run build --workspace @brewlite/frontend",
    "test": "npm run test --workspace @brewlite/backend && npm run test --workspace @brewlite/frontend",
    "lint": "npm run lint --workspace @brewlite/backend && npm run lint --workspace @brewlite/frontend",
    "lint:fix": "npm run lint:fix --workspace @brewlite/backend && npm run lint:fix --workspace @brewlite/frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run prisma:generate --workspace @brewlite/backend",
    "db:migrate": "npm run prisma:migrate --workspace @brewlite/backend",
    "db:seed": "npm run prisma:seed --workspace @brewlite/backend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "perf:products": "node scripts/perf/products.js",
    "perf:orders": "node scripts/perf/orders.js",
    "demo:record": "npm run test:e2e --workspace @brewlite/frontend -- e2e/demo-recording.spec.ts && node scripts/convert_demo_mp4.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.2",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
